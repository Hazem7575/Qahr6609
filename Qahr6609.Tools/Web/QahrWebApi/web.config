<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: deny everything in this folder from the web except the three example forms (which still refuse unless
     config.php has web_examples=true and the visitor IP is in web_allow_ips). config.php, QahrApi.php, _common.php,
     gen_key.php, selftest.php, example.php, README, .gitignore ... are never served. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config.php" />
          <add segment="config.example.php" />
          <add segment="QahrApi.php" />
          <add segment="_common.php" />
          <add segment="gen_key.php" />
          <add segment="selftest.php" />
          <add segment="example.php" />
          <add segment="README_AR.md" />
          <add segment=".gitignore" />
          <add segment=".htaccess" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="false">
          <add fileExtension=".php" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
